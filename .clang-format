BasedOnStyle: Google
IndentWidth: 2
ContinuationIndentWidth: 2
ColumnLimit: 0
UseTab: Never
AllowShortBlocksOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
IndentCaseLabels: true
AlignAfterOpenBracket: BlockIndent
Cpp11BracedListStyle: true
BinPackArguments: false
BinPackParameters: false
AlignConsecutiveMacros: AcrossEmptyLinesAndComments
AlignTrailingComments: true
IncludeBlocks: Regroup
IncludeIsMainRegex: "$."
IncludeCategories:
  - Regex: "^<cbprng/"
    Priority: 3
  - Regex: "^<fountain_code/"
    Priority: 4
  - Regex: "^<hash/"
    Priority: 5
  - Regex: "^<rand/"
    Priority: 6
  - Regex: "^<uint128/"
    Priority: 7
  - Regex: "^<utils/"
    Priority: 8
  - Regex: "^<openssl_rand_mod/"
    Priority: 9
  - Regex: "^<study/"
    Priority: 10
  - Regex: "^<openssl/"
    Priority: 1
  - Regex: "^<.*"
    Priority: 2
  - Regex: '^".*'
    Priority: 11
